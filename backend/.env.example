# Server
PORT=3847
NODE_ENV=production

# Comma-separated origins allowed to call the API (no trailing slash)
CORS_ORIGINS=https://www.abctest.com,https://abctest.com

# Gmail SMTP (requires 2-Step Verification + App Password — not your normal Gmail password)
# Google Account → Security → App passwords → create one for "Mail"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=abc@gmail.com
SMTP_PASS=your-16-char-gmail-app-password

# Sent "From" address (must match SMTP_USER for Gmail)
MAIL_FROM="ABC <abc@gmail.com>"

# Where enquiry & preview notifications are delivered
NOTIFY_EMAIL=hello@abc.com

# Shown in customer-facing preview emails as the contact address
CONTACT_EMAIL=hello@abc.com

# Path to PDF on the VPS (copy from site repo before deploy)
PDF_PATH=./assets/free-preview.pdf